# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional: deployed Google Apps Script Web App URL for non-blocking result logs.
# Never put a Google API key or Supabase service-role key in a VITE_ variable.
VITE_RESULTS_WEBHOOK_URL=https://script.google.com/macros/s/replace_me/exec
